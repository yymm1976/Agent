{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["evals/**/*.ts"],
  "exclude": ["node_modules", "evals/repo-tasks/fixtures", "evals/repo-tasks/hidden-tests"]
}
